<?php

/**
 * @file
 * Module hooks for Analyze AIO.
 */

declare(strict_types=1);

/**
 * @file
 * Provides AI optimization readiness analysis for content entities.
 */
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\analyze_aio\Hook\AnalyzeAioHooks;
use Drupal\Core\Entity\EntityInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function analyze_aio_help($route_name) {
  return \Drupal::service(AnalyzeAioHooks::class)->help($route_name);
}

/**
 * Implements hook_entity_update().
 */
#[LegacyHook]
function analyze_aio_entity_update(EntityInterface $entity): void {
  \Drupal::service(AnalyzeAioHooks::class)->entityUpdate($entity);
}

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function analyze_aio_entity_delete(EntityInterface $entity): void {
  \Drupal::service(AnalyzeAioHooks::class)->entityDelete($entity);
}

/**
 * Implements hook_views_pre_view().
 */
#[LegacyHook]
function analyze_aio_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  \Drupal::service(AnalyzeAioHooks::class)->viewsPreView($view, $display_id, $args);
}

/**
 * Implements hook_views_color_scale_popover_alter().
 */
#[LegacyHook]
function analyze_aio_views_color_scale_popover_alter(array &$content, array $context): void {
  \Drupal::service(AnalyzeAioHooks::class)->viewsColorScalePopoverAlter($content, $context);
}

/**
 * Checks if an entity type is supported by the AIO analyser.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE if supported.
 */
function _analyze_aio_is_supported_entity(EntityInterface $entity): bool {
  $config = \Drupal::config('analyze.settings');
  $status = $config->get('status') ?? [];

  $entity_type = $entity->getEntityTypeId();
  $bundle = $entity->bundle();

  return isset($status[$entity_type][$bundle]['analyze_aio_readiness']);
}

/**
 * Implements hook_runtime_requirements().
 */
function analyze_aio_runtime_requirements(): array {
  // Drupal 11.2 still invokes the legacy requirements hook.
  if (version_compare(\Drupal::VERSION, '11.3.0', '<')) {
    return [];
  }
  \Drupal::moduleHandler()->loadInclude('analyze_aio', 'install');
  return analyze_aio_requirements('runtime');
}
